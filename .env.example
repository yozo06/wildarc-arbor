# Settings for the server version's API (src/). The phone version needs none of this.
# Copy to .env in the repository root and fill in. Never commit .env.

# The database. Either:
#  - a free Supabase project: paste supabase/migrations/20261113000000_baseline.sql, then supabase/seed.sql,
#    into its SQL editor, and copy the URL and the service_role key from Project Settings > API; or
#  - Supabase on your computer (needs Docker): `npx supabase init` (keep the existing files), then
#    `npx supabase start` and `npx supabase db reset`, which runs the migration and the seed; it prints the URL
#    and the service_role key.
# The seed's sign-in, for a database on your own computer only: owner@example.com / arbor-local-only
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# Signs sign-in tokens. Any long random string.
JWT_SECRET=a_long_random_secret_min_32_chars
JWT_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# Photo upload in the server version goes to a Google Drive folder through a Google service account. Without
# these, everything works except uploading photos.
GOOGLE_SERVICE_ACCOUNT_EMAIL=arbor@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_shared_folder_id_here

APP_URL=http://localhost:5173
NODE_ENV=development
